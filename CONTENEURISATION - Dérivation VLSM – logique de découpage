version: "3.9"
services:
  db:
    image: postgres:16
    environment:
      POSTGRES_USER: logmein
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: logs
    volumes:
      - db-data:/var/lib/postgresql/data

  backend:
    build: ./backend
    environment:
      DB_HOST: db
      DB_USER: logmein
      DB_PASSWORD: ${DB_PASSWORD}
      DB_NAME: logs
    depends_on:
      - db

  frontend:
    build: ./frontend
    environment:
      API_URL: http://backend:8000
    depends_on:
      - backend

volumes:
  db-data:
